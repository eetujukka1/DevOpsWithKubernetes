generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Todo {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(2048)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("todos")
}
